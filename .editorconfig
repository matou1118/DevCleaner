root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.bat]
end_of_line = crlf          # cmd 读 LF 的 .bat 不可靠
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false   # 行尾两个空格是 Markdown 的换行

[settings.yaml]
indent_size = 2

[docs/palette-directions.html]
insert_final_newline = false
trim_trailing_whitespace = false
